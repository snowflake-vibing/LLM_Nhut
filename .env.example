# 1. Cloud Provider (Google Gemini API - Miễn phí tại aistudio.google.com)
GOOGLE_API_KEY=your_gemini_api_key_here
CLOUD_MODEL_NAME=gemini-1.5-flash

# 2. Local Provider (Ollama - Miễn phí tại ollama.ai)
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_MODEL_NAME=qwen2.5:latest

# 3. Chế độ mặc định ("cloud" hoặc "local")
DEFAULT_MODE=cloud
