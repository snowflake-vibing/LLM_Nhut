# ==============================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO LEGALTECH PLATFORM
# ==============================================================

# 1. Cloud Provider (Google Gemini API - Miễn phí tại aistudio.google.com)
GOOGLE_API_KEY=your_gemini_api_key_here
CLOUD_MODEL_NAME=gemini-3.5-flash-lite

# 2. Local Provider (Ollama - Miễn phí tại ollama.ai)
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_MODEL_NAME=qwen2.5:latest

# 3. Chế độ mặc định ("cloud" hoặc "local")
DEFAULT_MODE=cloud

# 4. Telegram Notification (Nhận báo cáo 24/7 về điện thoại)
# - Lấy TELEGRAM_BOT_TOKEN: Chat với @BotFather trên Telegram -> gõ /newbot
# - Lấy TELEGRAM_CHAT_ID: Chat với @userinfobot trên Telegram -> copy Id
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
